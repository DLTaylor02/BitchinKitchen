# Include the generated copy from your existing NGINX http block. This server
# listens on its own port and does not replace any existing application.
server {
    listen 0.0.0.0:{{PORT}};
    server_name _;
    root "{{PROJECT_ROOT}}/public";
    index index.php;
    client_max_body_size {{UPLOAD_MAX_REQUEST_MB}}M;
    access_log /var/log/nginx/bitchin-kitchen-access.log;
    error_log /var/log/nginx/bitchin-kitchen-error.log;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        application/json
        application/javascript
        application/xml
        image/svg+xml;

    location / { try_files $uri $uri/ /index.php?$query_string; }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:{{FPM_SOCKET}};
        fastcgi_read_timeout {{PHP_REQUEST_SECONDS}}s;
    }
    location ~ \.php(?:/|$) { return 404; }
    location ~ /\. { deny all; }
    location ^~ /uploads/ { try_files $uri =404; }
}
