# Include the generated copy from your existing NGINX http block. This server
# listens on its own port and does not replace any existing application.
server {
    listen 127.0.0.1:{{PORT}};
    server_name localhost;
    root "{{PROJECT_ROOT}}/public";
    index index.php;
    client_max_body_size 32M;
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        # Change this if your PHP-FPM service uses a Unix socket.
        fastcgi_pass 127.0.0.1:9000;
    }
    location ~ /\. { deny all; }
    location ^~ /uploads/ { try_files $uri =404; }
}
